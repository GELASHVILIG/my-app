{
  "name": "my-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "cdk:diff": "cdk diff --app 'tsx infra/bin/app.ts'",
    "cdk:synth": "cdk synth --app 'tsx infra/bin/app.ts'"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.0.0",
    "aws-cdk": "^2.1029.0",
    "aws-cdk-lib": "^2.219.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.4.2",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1110.0",
    "@aws-sdk/lib-dynamodb": "^3.1110.0",
    "fast-xml-parser": "^5.10.1"
  }
}
