{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "implementer|tester",
        "hooks": [
          { "type": "command", "command": "$HOME/projects/claude-config/hooks/quality-gate.sh", "timeout": 300 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/projects/claude-config/hooks/quality-gate.sh", "timeout": 300 }
        ]
      }
    ]
  }
}
